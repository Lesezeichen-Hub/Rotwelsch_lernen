{
  "name": "rotwelsch-lernen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-Lernmodul fuer belegtes Rotwelsch im Lesezeichen-Hub",
  "scripts": {
    "start": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:content": "node tools/validate-content.mjs",
    "test:ui": "node tests/ui/ui.test.mjs",
    "test:offline": "node tests/ui/update.test.mjs",
    "test:all": "npm test && npm run test:content && npm run test:ui && npm run test:offline"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "ts-fsrs": "5.2.3",
    "lucide": "0.468.0",
    "@fontsource/source-serif-4": "5.1.1",
    "@fontsource/source-sans-3": "5.1.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1"
  }
}